# Kommo — copie para .env (NUNCA commitar o .env, o repositório é público)
KOMMO_SUBDOMAIN=
KOMMO_TOKEN=
# Opcionais: se vazios, o lead cai no funil/etapa padrão da conta
KOMMO_PIPELINE_ID=
KOMMO_STATUS_ID=
KOMMO_RESPONSIBLE_USER_ID=
# Planilha de leads (Apps Script) — mantém o backup funcionando
SHEETS_ENDPOINT=https://script.google.com/macros/s/AKfycbxwqQwuOtq0IPh64vOpuQ1gEUjUp57UOfCuUmSL9mFCPPjX8WjLOr6NgyM_XRaB2YLg/exec

# --- Conversões offline (Kommo → Google Ads) ---
# Chave que o Kommo manda na URL do webhook (?key=...)
WEBHOOK_SECRET=
# App da Web do Apps Script da planilha de conversões (scripts/apps-script-conversoes.gs)
CONVERSIONS_ENDPOINT=
# Etapas do funil que viram conversão
KOMMO_STATUS_QUALIFICADO=109867911
KOMMO_STATUS_VENDA=142
